# ---------- Python ----------
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/

# ---------- 打包产物（PyInstaller，见 docx/ENVIRONMENT.md 的"打包"一节）----------
# build/ 和 dist/ 是产物，*.spec 是 PyInstaller 的默认产物名；
# 但 packaging/ZpinControl.spec 是**构建输入**，必须入库，所以下面开了白名单。
build/
dist/
*.spec
!packaging/ZpinControl.spec

# ---------- 本机配置与运行记录（向导生成，含串口/网卡，不可提交）----------
master/config.local.toml
master/runs/

# ---------- 编辑器 / 系统 ----------
.vscode/
.idea/
Thumbs.db
desktop.ini

# ---------- 第三方二进制与手册 ----------
# 注意：这两个文件在 .gitignore 生效之前就已经被 git 跟踪了，
# 所以本规则对它们**当前无效**（快照里仍带着它们）。
# 将来若要减小仓库体积：git rm --cached 后另行决定，别直接删文件。
third-party/drivers/*.exe
third-party/docs/*.PDF

# Native host-compiled firmware test artifact
tests/firmware_head_harness.exe

# GitHub publication: keep local development/experiment material out of Git.
/docs/
# Consolidated local development archive; the empty user Q&A stays versionable.
/docx/*
!/docx/Q&A.md
/tests/
/DEVELOPMENT_LOG.md
/ENVIRONMENT.md
/findings.md
/progress.md
/task_plan.md
/third-party/docs/
/third-party/drivers/
/third-party/hardware/
/third-party/AccelStepper/examples/
/third-party/AccelStepper/extras/
/firmware/legacy/
/scripts/demo_no_hardware.py
**/config.local.toml
**/profiles/
**/runs/
*.log
.env
.env.*
!.env.example
.claude/
.codex/
.agents/

# Older loose reference files and vendor examples are local-only too.
/*.PDF
/*.pdf
/*.exe
/*.jpg
/*.png
/1.cpp
/libraries/AccelStepper/examples/
/libraries/AccelStepper/extras/
